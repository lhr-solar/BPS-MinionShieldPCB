	(text "Version History:\n"
		(exclude_from_sim no)
		(at 217.17 17.145 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2342ef29-089f-40b4-a8c3-4b7785a52b7c")
	)
	(text "v2.3:\nFix footprint issues\nUpdate RC values to match timing of the LTC6811\nRedo PCB layout to reduce islands and vias\n\nv2.2:\nPCB layout to make everything symmetrical\nand easier to solder\n\nv2.1:\nBoard supports 16 temperature sensors, add \nRC filter to all temperature sensors"
		(exclude_from_sim no)
		(at 217.805 41.275 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3230c513-c13b-485e-8405-83e926cbfb05")
	)
	(text "Scrutineering Inputs"
		(exclude_from_sim no)
		(at 86.36 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "57c5f45e-0cce-4ea9-a3e6-3216d27132cd")
	)
	(text "LTC6811 delay between sleep and \nmeasuring ADC voltage is T_WAKE+T_REFUP\n\nT_WAKE+T_REFUP = 200us+2.7ms=2.9ms (minimum)\nfreq = 1/.0029 = 345Hz\n\nSetting LC cutoff freq to 2*345 = 690\nUsing a 47nF cap and 4.7K resistor,\nwe achieve a cutoff freq of 720Hz. \n\n\n"
		(exclude_from_sim no)
		(at 227.965 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "637cf6e2-cea1-4882-a714-cedcd4849456")
	)
	(text "Output to minion"
